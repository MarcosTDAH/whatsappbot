# ==========================================================
# 1. CHAVE DE API DO GOOGLE GEMINI (Extração de dados com IA)
# ==========================================================
# Crie gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# ==========================================================
# 2. CONFIGURAÇÕES DO GOOGLE DRIVE E GOOGLE SHEETS
# ==========================================================
# ID da pasta do Google Drive (pegue na URL da pasta: drive.google.com/drive/folders/ESTE_ID_AQUI)
GOOGLE_DRIVE_FOLDER_ID=id_da_pasta_do_drive_aqui

# ID da planilha do Google Sheets (pegue na URL: docs.google.com/spreadsheets/d/ESTE_ID_AQUI/edit)
GOOGLE_SHEETS_ID=id_da_planilha_aqui

# Nome da aba da planilha onde os dados serão gravados (Padrão: Comprovantes)
GOOGLE_SHEETS_TAB=Comprovantes

# URL do Apps Script da sua planilha (usa direto o seu e-mail sem precisar de login OAuth no bot!)
# Veja as instruções no arquivo: google-apps-script.js
GOOGLE_APPS_SCRIPT_URL=

# ==========================================================
# 3. COMPORTAMENTO DO BOT NO WHATSAPP
# ==========================================================
# Se "true", processa apenas imagens/PDFs que a IA identificar como comprovante de pagamento.
# Se "false", salva qualquer imagem enviada.
ONLY_RECEIPTS=true

# Se "true", envia mensagem de confirmação no WhatsApp após registrar o comprovante.
SEND_CONFIRMATION_REPLY=true

# Se "true", ignora mensagens enviadas em grupos (processa apenas conversas privadas).
# Se "false", processa também imagens enviadas em grupos.
IGNORE_GROUPS=false

# (Opcional) Lista de IDs de chats/grupos ou números permitidos separados por vírgula.
# Deixe em branco para aceitar de qualquer conversa.
# Exemplo: ALLOWED_CHATS=5511999999999@s.whatsapp.net,120363012345678@g.us
ALLOWED_CHATS=
